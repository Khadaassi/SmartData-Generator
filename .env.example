# Copier ce fichier vers .env et renseigner les valeurs.
# .env ne doit jamais être commité (cf. docs/01_framing/functional_technical_scope.md, section 17).

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Base PostgreSQL applicative (projets, exécutions, rapports) ---
DATABASE_URL=postgresql+psycopg://smartdata:smartdata@localhost:5432/smartdata_generator

# --- ChromaDB (base vectorielle du RAG) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=smartdata_generator

# --- Fournisseur LLM (abstrait, cf. section 12.8 du cadrage) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optionnel : requis pour un fournisseur local/self-hosted (ex. Ollama, vLLM).
LLM_BASE_URL=

# --- Fournisseur d'embeddings (abstrait) ---
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=

# --- Stockage local (documents métier, exports) ---
DOCUMENTS_STORAGE_DIR=./data/documents
EXPORT_OUTPUT_DIR=./data/exports
