# Copier ce fichier vers .env et renseigner les valeurs.
# .env ne doit jamais être commité (cf. docs/01_framing/functional_technical_scope.md, section 17).

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Base PostgreSQL applicative (projets, exécutions, rapports) ---
DATABASE_URL=postgresql+psycopg://smartdata:smartdata@localhost:5432/smartdata_generator

# --- ChromaDB (base vectorielle du RAG) ---
# Serveur lancé via `docker compose -f docker/docker-compose.yml up -d` (cf. README).
CHROMA_HOST=localhost
CHROMA_PORT=8020
CHROMA_COLLECTION_NAME=smartdata_generator

# --- Fournisseur LLM (Groq, cf. section 12.8 du cadrage pour l'abstraction) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Clé Groq : https://console.groq.com/keys
LLM_API_KEY=

# --- Fournisseur d'embeddings (Ollama, local) ---
# bge-m3 : multilingue (le français est mal discriminé par mxbai-embed-large, testé et écarté).
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_BASE_URL=http://localhost:11434

# --- Stockage local (documents métier, exports) ---
DOCUMENTS_STORAGE_DIR=./data/documents
EXPORT_OUTPUT_DIR=./data/exports

# --- Interface Streamlit (client de l'API FastAPI, aucun secret Groq/Ollama/PostgreSQL ici) ---
STREAMLIT_API_BASE_URL=http://localhost:8000
STREAMLIT_REQUEST_TIMEOUT=120
